# Server Configuration
NODE_ENV=development
PORT=1000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hubini_db
DB_CONNECTION_LIMIT=10


JWT_SECRET=16_bit_character_should_go_here_pls
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=16_bit_character_should_go_here_pls
JWT_REFRESH_EXPIRES_IN=30d

# Email (optional - for verification emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=theHubini_email_we_would_be_using
SMTP_PASS=_hubini_app_pasword
EMAIL_FROM=Hubini <noreply@hubini.com>

# Frontend URL
FRONTEND_URL=http://localhost:3001

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# WebSocket
WS_HEARTBEAT_INTERVAL=30000